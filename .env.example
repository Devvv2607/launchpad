# Copy to .env and fill in. Never commit .env.
# `make keys` prints fresh values for JWT_SECRET and TOKEN_ENCRYPTION_KEYS.

# --- App ---
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database / queue (docker-compose overrides these for containers) ---
DATABASE_URL=postgresql+asyncpg://launchpad:launchpad@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379/0

# --- Auth: "local" (API-issued JWTs) or "supabase" (verify Supabase JWTs) ---
AUTH_PROVIDER=local
JWT_SECRET=replace-with-64-random-chars
# SUPABASE_URL=https://<project>.supabase.co

# --- Encryption of OAuth tokens at rest (comma-separated Fernet keys; first one encrypts) ---
TOKEN_ENCRYPTION_KEYS=replace-with-fernet-key

# --- LLM: provider is one of groq | gemini | openai | anthropic ---
# Model IDs have no defaults on purpose. Copy current IDs from the provider's docs.
LLM_PROVIDER=
LLM_MODEL=
LLM_FAST_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_RUN_TOKEN_BUDGET=200000
AGENT_RUN_COST_BUDGET_USD=1.00

# --- Embeddings for brand-doc RAG: gemini | openai (768-dim vectors) ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Image generation: gemini | openai | replicate ---
IMAGE_PROVIDER=
IMAGE_MODEL=
REPLICATE_API_TOKEN=

# --- Web research ---
TAVILY_API_KEY=

# --- Storage: "local" (./.storage) or "s3" (MinIO / Supabase Storage / R2 / S3) ---
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/launchpad
S3_BUCKET=launchpad
S3_REGION=auto
S3_ACCESS_KEY_ID=launchpad
S3_SECRET_ACCESS_KEY=launchpad-dev-secret

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Social OAuth apps ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Optional tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
