# Copy to .env and fill in. Never commit .env.
# `make keys` prints fresh values for JWT_SECRET and TOKEN_ENCRYPTION_KEYS.

# --- App ---
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Database / queue (docker-compose overrides these for containers) ---
DATABASE_URL=postgresql+asyncpg://launchpad:launchpad@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379/0

# --- Auth: "local" (API-issued JWTs) or "supabase" (verify Supabase JWTs) ---
AUTH_PROVIDER=local
JWT_SECRET=replace-with-64-random-chars
# SUPABASE_URL=https://<project>.supabase.co

# --- Encryption of OAuth tokens at rest (comma-separated Fernet keys; first one encrypts) ---
TOKEN_ENCRYPTION_KEYS=replace-with-fernet-key

# --- LLM -------------------------------------------------------------------------------
# Provider: gemini | groq | openai | anthropic. Model IDs have NO code defaults on purpose:
# a retired ID fails loudly with "check the model ID in .env" instead of silently degrading.
#
# Model IDs below were taken from each provider's official docs on 2026-10-02:
#   Gemini     https://ai.google.dev/gemini-api/docs/models
#   Groq       https://console.groq.com/docs/models  (+ /docs/structured-outputs)
#   OpenAI     https://developers.openai.com/api/docs/models   (not live-checked: no key)
#   Anthropic  Anthropic models table, 2026-09-25               (not live-checked: no key)
# Gemini + Groq IDs are re-verified against the live /models endpoints by
# `RUN_LIVE_TESTS=1 pytest -m live` (test_configured_model_ids_exist).
LLM_PROVIDER=gemini
# Writing + planning. Alternatives: gemini-3.8-flash, gemini-3.5-flash
LLM_MODEL=gemini-3.6-flash
# Critique, hashtags, extraction (cheaper/faster). Falls back to LLM_MODEL if empty.
LLM_FAST_MODEL=gemini-3.1-flash-lite
# Secondary provider examples (select per purpose in Settings -> AI; never used as a silent fallback):
#   groq:      openai/gpt-oss-120b (writing), openai/gpt-oss-20b (fast)  - strict JSON schema
#   openai:    gpt-6.1-sol, gpt-6-luna
#   anthropic: claude-sonnet-5-5, claude-haiku-4-5
LLM_TEMPERATURE=0.7
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Retries on 429/5xx/timeouts only (exponential backoff + jitter, honours Retry-After).
LLM_MAX_RETRIES=3
# Max concurrent LLM calls per provider per process; extra calls queue. Groq's free tier
# (8k tokens/min on gpt-oss-20b) needs 1; paid tiers can go higher.
LLM_MAX_CONCURRENCY=4
# Optional: cap one request's input + max_tokens. Groq's free tier rejects any request above its
# tokens-per-minute limit (8000 on gpt-oss), so set 8000 there. Empty = no cap.
LLM_MAX_REQUEST_TOKENS=
# Store full prompts/outputs on llm_calls rows. Off by default (privacy + DB size).
LOG_LLM_PAYLOADS=false
# Per-workspace daily AI spend cap in USD (workspace settings can override). Calls with an
# unknown price count as $0 toward the cap, so keep model prices in llm/pricing.py current.
DAILY_SPEND_CAP_USD=2.00
# Per agent run: stop (and say so) once the run's LLM usage reaches either budget.
AGENT_RUN_TOKEN_BUDGET=200000
AGENT_RUN_COST_BUDGET_USD=1.00
# Max tool calls in one agent run; further calls are refused and the agent summarises.
AGENT_MAX_TOOL_CALLS=25

# --- Embeddings for brand-doc RAG ----------------------------------------------------------
# gemini-embedding-001 defaults to 3072 dims; we request 768 via outputDimensionality
# (pgvector HNSW indexes cap at 2000 dims). EMBEDDING_DIM must match the DB column;
# changing it needs a migration + re-index.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Image generation: gemini | openai | replicate ---
IMAGE_PROVIDER=
IMAGE_MODEL=
REPLICATE_API_TOKEN=

# --- Web research ---
TAVILY_API_KEY=
# Drop research results below this Tavily relevance score (0-1).
RESEARCH_MIN_SCORE=0.5

# --- Storage: "local" (./.storage) or "s3" (MinIO / Supabase Storage / R2 / S3) ---
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/launchpad
S3_BUCKET=launchpad
S3_REGION=auto
S3_ACCESS_KEY_ID=launchpad
S3_SECRET_ACCESS_KEY=launchpad-dev-secret

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Social OAuth apps ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Optional tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
