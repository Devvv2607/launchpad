{# Body fragment only: sanitised, then wrapped in a static skeleton by email_render. #}
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{ preheader }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f5f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
<tr><td style="padding:20px 28px;border-bottom:4px solid {{ primary }};">
{% if logo_url %}<img src="{{ logo_url }}" alt="{{ business_name }}" height="40" style="height:40px;width:auto;display:block;border:0;">{% else %}<span style="font:700 20px Arial,Helvetica,sans-serif;color:{{ primary }};">{{ business_name }}</span>{% endif %}
</td></tr>
{% for s in sections %}
{% if s.type == "hero" %}
<tr><td style="padding:28px 28px 8px 28px;font-family:Arial,Helvetica,sans-serif;">
{% if s.heading %}<h1 style="margin:0 0 12px 0;font-size:26px;line-height:1.25;color:#111827;">{{ s.heading }}</h1>{% endif %}
{% if s.body %}<p style="margin:0;font-size:16px;line-height:1.6;color:#374151;">{{ s.body }}</p>{% endif %}
</td></tr>
{% elif s.type == "text" %}
<tr><td style="padding:16px 28px;font-family:Arial,Helvetica,sans-serif;">
{% if s.heading %}<h2 style="margin:0 0 8px 0;font-size:19px;color:#111827;">{{ s.heading }}</h2>{% endif %}
{% if s.body %}<p style="margin:0;font-size:16px;line-height:1.6;color:#374151;">{{ s.body }}</p>{% endif %}
</td></tr>
{% elif s.type == "bullets" %}
<tr><td style="padding:16px 28px;font-family:Arial,Helvetica,sans-serif;">
{% if s.heading %}<h2 style="margin:0 0 8px 0;font-size:19px;color:#111827;">{{ s.heading }}</h2>{% endif %}
<ul style="margin:0;padding-left:20px;font-size:16px;line-height:1.6;color:#374151;">{% for item in s["items"] %}<li style="margin:0 0 6px 0;">{{ item }}</li>{% endfor %}</ul>
</td></tr>
{% elif s.type == "quote" %}
<tr><td style="padding:16px 28px;font-family:Georgia,serif;">
<p style="margin:0;padding-left:14px;border-left:3px solid {{ secondary }};font-size:17px;font-style:italic;line-height:1.6;color:#374151;">{{ s.body }}</p>
</td></tr>
{% elif s.type == "cta" %}
<tr><td align="center" style="padding:24px 28px;font-family:Arial,Helvetica,sans-serif;">
{% if s.heading %}<p style="margin:0 0 14px 0;font-size:16px;color:#374151;">{{ s.heading }}</p>{% endif %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="{{ primary }}" style="border-radius:6px;">
<a href="{{ s.button_url }}" style="display:inline-block;padding:14px 26px;font:700 16px Arial,Helvetica,sans-serif;color:{{ button_text }};text-decoration:none;border-radius:6px;">{{ s.button_label }}</a>
</td></tr></table>
</td></tr>
{% endif %}
{% endfor %}
<tr><td style="padding:20px 28px;border-top:1px solid #e5e7eb;font:12px/1.5 Arial,Helvetica,sans-serif;color:#6b7280;">
{{ business_name }}{% if locations %} · {{ locations }}{% endif %}<br>
You're receiving this because you subscribed to updates from {{ business_name }}. <a href="{{ unsubscribe_url }}" style="color:#6b7280;">Unsubscribe</a>
</td></tr>
</table>
</td></tr>
</table>
